# Backend Environment Variables
# Copy to .env and fill values before running

# Database
DATABASE_URL=postgresql://sam2:changeme@postgres:5432/sam2db
DB_HOST=postgres
DB_PORT=5432
DB_USER=sam2
DB_PASSWORD=changeme
DB_NAME=sam2db

# Redis
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0

# MinIO/S3
MINIO_URL=http://minio:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
S3_BUCKET=sam2-bucket

# Flask
SECRET_KEY=replace-with-a-very-secret-key
FLASK_ENV=production
FLASK_DEBUG=False

# JWT
JWT_SECRET_KEY=replace-with-jwt-secret

# Kubernetes
KUBERNETES_NAMESPACE=sam2

# Optional: R2 / Supabase (if using)
R2_ACCOUNT_ID=
R2_ACCESS_KEY=
R2_SECRET_KEY=
SUPABASE_URL=
SUPABASE_KEY=

# Cloudflare Tunnel
CLOUDFLARED_TUNNEL_TOKEN=
DOMAIN=example.com
