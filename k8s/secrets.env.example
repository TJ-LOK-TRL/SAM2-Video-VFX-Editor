# Database (local postgres or external Supabase)
db-user=sam2user
db-password=changeme
db-name=sam2db
database-url=postgresql://sam2user:changeme@postgres:5432/sam2db

# JWT
jwt-secret=replace-with-random-secret

# Redis
redis-url=redis://redis:6379/0

# MinIO (local S3-compatible storage)
minio-user=minioadmin
minio-password=minioadmin

# Storage provider: "minio" or "r2"
storage-provider=minio

# Cloudflare R2 (used when storage-provider=r2)
r2-endpoint=https://<account-id>.r2.cloudflarestorage.com
r2-access-key=your-r2-access-key
r2-secret-key=your-r2-secret-key
r2-bucket-videos=videos
r2-bucket-outputs=outputs
r2-bucket-backups=db-backups

telegram-bot-token=...
telegram-chat-id=...

# Cloudflare Tunnel (Quick Tunnel with Workers KV redirect)
# Cloudflared does not use tunnel token; generates random *.trycloudflare.com URL
# and POSTs it to this Workers endpoint for fixed redirect
worker-update-url=https://your-worker.workers.dev

# Kubernetes
k8s-namespace=sam2

# SAM2 inference job image
sam2-job-image=ghcr.io/<your-github-username>/sam2-vfx/sam2-job:latest